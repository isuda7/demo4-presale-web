# 값은 절대 커밋하지 마세요. 로컬은 .env, 운영은 Vercel 프로젝트 환경변수에 설정합니다.

# 관리자 로그인 비밀번호
ADMIN_PASSWORD=
# 관리자 토큰 서명용 비밀값 (32자 이상 무작위 문자열)
ADMIN_TOKEN_SECRET=

# Turso (운영 필수, 로컬은 비워두면 backend/data/local.db 파일 DB 사용)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 로컬 API 포트 (선택, 기본 8787)
API_PORT=

# 운영 사이트 주소 (사이트맵·canonical·llms.txt 기준). 예: https://www.example.com
SITE_URL=

# 검색엔진 소유 확인 코드 (HTML 태그 방식의 content 값만). 메인 페이지에 메타태그로 들어간다
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# 검색 노출 스위치: 기본(비움)은 차단 — 모든 페이지 noindex, AI 크롤러 차단, 사이트맵·llms.txt 미생성. 공개할 때만 on
SEARCH_INDEXING=
